{
  "name": "@reachinbox/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c green,yellow \"tsx watch src/index.ts\" \"tsx watch src/worker-main.ts\"",
